{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local",
        "//": "ARM only. The Agora video SDK ships a large native library per ABI, and the x86 ones are only used by emulators and a few Chromebooks - dropping them roughly halves the bundle.",
        "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6809633389",
        "ascApiKeyPath": "./AuthKey_5A92QT97Z2.p8",
        "ascApiKeyId": "5A92QT97Z2",
        "ascApiKeyIssuerId": "aa9faf8d-f9dd-417b-8fc9-d644b9bdff4c"
      }
    }
  }
}
