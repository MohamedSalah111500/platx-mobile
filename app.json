{
  "expo": {
    "name": "PlatX",
    "slug": "platx",
    "scheme": "platx",
    "version": "1.0.6",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121935"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platx.platform",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The microphone is used for live class audio and to record voice feedback.",
        "NSCameraUsageDescription": "The camera is used for live video classes.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used to attach payment proof and share images in chat."
      }
    },
    "android": {
      "package": "com.platx.platform",
      "versionCode": 23,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121935"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableHermes": true,
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          },
          "ios": {
            "enableHermes": true
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is used to attach payment proof and share images in chat.",
          "cameraPermission": "The camera is used for live video classes."
        }
      ],
      "./plugins/removePermissions",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ]
  }
}
