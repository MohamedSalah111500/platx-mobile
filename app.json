{
  "expo": {
    "name": "PlatX",
    "slug": "platx",
    "scheme": "platx",
    "version": "1.0.9",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platx.platform",
      "buildNumber": "4",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The microphone is used for live class audio and to record voice feedback.",
        "NSCameraUsageDescription": "The camera is used for live video classes.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used to attach payment proof and share images in chat.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.platx.platform",
      "versionCode": 26,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121935"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableHermes": true,
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          },
          "ios": {
            "enableHermes": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#121935"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is used to attach payment proof and share images in chat.",
          "cameraPermission": "The camera is used for live video classes."
        }
      ],
      "./plugins/removePermissions",
      "expo-localization",
      "expo-secure-store",
      "expo-asset",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "5678442e-0445-4ce2-bf53-ca22b8cb6e44"
      }
    },
    "owner": "mosalah1500"
  }
}
